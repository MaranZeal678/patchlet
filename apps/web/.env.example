# Action Compiler — copy to .env.local

# Model access: one key, one OpenAI-shaped surface (lib/openai.ts).
# OPENAI_API_KEY preferred (GPT-5 + text-embedding-3-large at 1024 dims);
# MISTRAL_API_KEY works as a fallback through Mistral's compatible endpoint.
OPENAI_API_KEY=
MISTRAL_API_KEY=

# The demo target app (Meridian Supply admin).
TARGET_ORIGIN=http://localhost:5210
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Reflex (reflex.runloop.ai) personal API key (rfx_...), Settings → API keys.
# When set, every compile adds a lineage written by a real coding agent in an
# isolated Runloop devbox (Codex if the org has OpenAI credentials in Reflex,
# opencode on Runloop-provided models otherwise).
RUNLOOP_API_KEY=
REFLEX_ORG=doing-something
