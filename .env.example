# Copy to .env.local (apps/web) or export in your shell. Names only, never commit values.

# --- Secrets (server-side only, never exposed to the browser) ---
MISTRAL_API_KEY=            # Mistral API key, used by every model call
SUPABASE_URL=               # https://<ref>.supabase.co
SUPABASE_ANON_KEY=          # anon key, the value behind NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=  # service role key, server-side only
DATABASE_URL=               # Postgres session-mode pooler URL, migrations only
GITHUB_TOKEN=               # fine-grained PAT with contents/issues/pull-requests on the target repo
VERCEL_TOKEN=               # Vercel token, used to watch the target project's deployments
GITHUB_OAUTH_CLIENT_ID=     # OAuth app that lets a console user link their own GitHub account
GITHUB_OAUTH_CLIENT_SECRET= # secret of that OAuth app
GITHUB_OAUTH_REDIRECT=      # https://<app>/api/github/callback, must match the OAuth app exactly

# --- Non-secret configuration ---
PATCHLET_PROJECT_SLUG=not-mistral                 # slug the seed script gives the demo project
PATCHLET_DEMO_OWNER_EMAIL=                        # account the seed hands the demo project to, blank leaves it unowned
ESCALATION_ENGINE=mistral                         # 'mistral' for Mistral Workflows, 'local' for the worker's local runner
MISTRAL_WORKFLOW_NAME=patchlet-missing-feature    # registered workflow name
MISTRAL_DEPLOYMENT_NAME=patchlet-worker           # worker deployment name (worker reads it as DEPLOYMENT_NAME)
NEXT_PUBLIC_APP_URL=http://localhost:3000         # public origin of the dashboard, base of the widget script URL
TARGET_VERCEL_PROJECT=not-mistral                 # Vercel project whose deployment the worker waits for
SLACK_WEBHOOK_URL=                                # optional Slack incoming webhook; the worker posts once when the issue is filed and once when the draft PR opens

# --- Public configuration (inlined into the browser bundle) ---
# Both values are public by design: the anon key only ever reaches Supabase Auth, which enforces
# row level security. They equal SUPABASE_URL and SUPABASE_ANON_KEY above.
NEXT_PUBLIC_SUPABASE_URL=                         # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                    # Supabase anon key, used by the sign-in screen
