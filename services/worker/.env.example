# Secrets (never commit values; on the dev machine vault-exec injects them)
MISTRAL_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
VERCEL_TOKEN=

# Mistral Workflows worker deployment name (must match MISTRAL_DEPLOYMENT_NAME in the dashboard)
DEPLOYMENT_NAME=patchlet-worker

# Vercel project whose deployment the worker waits for after a merge
TARGET_VERCEL_PROJECT=not-mistral

# Public origin of the dashboard: the worker links back to NEXT_PUBLIC_APP_URL/console/activity
# from the comment it leaves on the draft pull request
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Slack incoming webhook: one message when the issue is filed, one when the draft PR opens
SLACK_WEBHOOK_URL=

# Optional: where cached node_modules live (default ~/.cache/patchlet)
PATCHLET_CACHE_DIR=
